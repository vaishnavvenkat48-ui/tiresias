# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Leave empty in development to use an embedded MongoDB stored on disk in backend/.data/db
# (data persists across restarts). Required in production. MONGODB_URI is accepted as an alias.
MONGO_URI=
# Embedded DB options (development only)
MONGO_EPHEMERAL=false
LOCAL_DB_PATH=
LOCAL_DB_PORT=27027

# ── Authentication ─────────────────────────────────────
# Long random strings (≥ 32 chars). Required in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── AI (Google Gemini) — optional; without it graphs are built from retrieved sources only
GEMINI_API_KEY=
# Preferred model, then fallbacks tried in order (hedged after GEMINI_HEDGE_MS)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
GEMINI_HEDGE_MS=9000

# ── Video retrieval (YouTube Data API v3) — optional
YOUTUBE_API_KEY=

# ── Academic knowledge — optional (OpenAlex works without a key on a shared daily budget)
OPENALEX_API_KEY=
# Optional contact e-mail for Crossref's "polite pool"
CROSSREF_MAILTO=

# ── Images — optional extras (Wikimedia Commons needs no key)
UNSPLASH_ACCESS_KEY=
OPENVERSE_TOKEN=

# ── Wikimedia API etiquette (descriptive User-Agent with contact info is recommended)
WIKIMEDIA_USER_AGENT=

# ── Deployment ─────────────────────────────────────────
# Set to 1 (or the hop count) behind a reverse proxy (Render, Fly, nginx) so per-IP limits see the real client IP
TRUST_PROXY=
# The API serves frontend/dist when it exists; set false to serve the API only
SERVE_FRONTEND=

# ── Quotas & cost control (per day) ────────────────────
QUOTA_GENERATIONS_PER_USER=40
QUOTA_EXPANSIONS_PER_USER=150
QUOTA_AI_PER_USER=80
# Anonymous /try maps per IP per day (sources only, no AI)
QUOTA_TRY_PER_IP=3
# Hard global cap on Gemini calls per day (keeps the free tier from being exceeded)
GEMINI_DAILY_CALL_CAP=1500

# ── Seeding (npm run seed) — never commit real credentials
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=